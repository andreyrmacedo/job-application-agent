# Copy to .env and fill in the blanks. .env is gitignored; this file is not.
#
#   cp .env.example .env

# ---- LLM ------------------------------------------------------------------
# Any OpenAI-compatible server: llama.cpp, vLLM, LM Studio, Ollama (/v1).
# Empty = the defaults in settings.py (http://localhost:8080/v1).
LLM_BASE_URL=
# The server's model id:  curl -s <LLM_BASE_URL>/models
LLM_MODEL=
# Only for hosted endpoints; a local llama.cpp server ignores it
LLM_API_KEY=

# ---- Browser ----------------------------------------------------------------
# The Chromium-family browser started with --remote-debugging-port=9222
BROWSER_URL=

# ---- Job-site login ---------------------------------------------------------
# The e-mail the navigator types on login pages. The PASSWORD does not go
# here: put LOGIN_PASSWORD=... in .env.secrets, which only the browser reads.
LOGIN_EMAIL=

# ---- Profile ----------------------------------------------------------------
# File under config/ (default profile.yaml; falls back to profile.example.yaml)
PROFILE_FILE=

# ---- LangSmith tracing (optional) -------------------------------------------
# Read by the langsmith SDK itself. Traces contain your profile and the pages
# visited: leave tracing off unless you want them.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
